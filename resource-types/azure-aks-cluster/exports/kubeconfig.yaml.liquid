apiVersion: v1
kind: Config
clusters:
  - name: {{ artifact.name }}
    cluster:
      certificate-authority-data: {{ artifact.authentication.cluster.certificate-authority-data }}
      server: {{ artifact.authentication.cluster.server }}
contexts:
  - name: {{ artifact.name }}
    context:
      cluster: {{ artifact.name }}
      user: {{ artifact.name }}
current-context: {{ artifact.name }}
users:
  - name: {{ artifact.name }}
    user:
      token: {{ artifact.authentication.user.token }}
